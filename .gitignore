# Lumen repository ignores.

# PlatformIO / ESP-IDF build artifacts
.pio/
.sdkconfig*
!sdkconfig.defaults
!sdkconfig.defaults.*
managed_components/
dependencies.lock

# Generated LittleFS / web build output
.lfs-tmp/
webui/dist/
**/littlefs.bin
**/spiffs.bin

# Node
node_modules/
coverage/
playwright-report/
test-results/
.vite/

# Host unit test temp directories (created/cleaned by test setUp/tearDown;
# a crashed run can leave them behind).
.test_*_tmp/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Python (schema tooling)
__pycache__/
*.pyc
.venv/

# Local development secrets (Wi-Fi seed credentials)
secrets.ini

# Generated LittleFS image source (built from webui/dist by scripts/build_fs.py)
data/
include/lumen/generated/

# Integration test stack state and generated credentials (test/integration/ha)
test/integration/ha/.env
test/integration/ha/.ha_token
test/integration/ha/ha-config/
test/integration/ha/mosquitto/passwd
test/integration/ha/mosquitto/data/
test/soak/results/
