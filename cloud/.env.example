# Copy to .env for docker compose. Development values only — production
# values come from the platform's secret store (P11), never from a file.
LUMEN_ENVIRONMENT=development
LUMEN_JWT_SECRET=dev-insecure-change-me-0123456789abcdef
LUMEN_HOOK_SECRET=dev-insecure-change-me-0123456789abcdef
LUMEN_KEK=dev-insecure-change-me-0123456789abcdef
EMQX_DASHBOARD_PASSWORD=dev-emqx-dashboard
EMQX_NODE_COOKIE=dev-emqx-cookie
