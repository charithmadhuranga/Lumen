{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumen.invalid/protocol/v1/common.schema.json",
  "title": "Lumen protocol v1 — shared definitions",
  "$defs": {
    "version": { "const": 1 },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "localId": { "type": "string", "pattern": "^[a-z0-9_-]{1,48}$" },
    "timestampMs": { "type": "integer", "minimum": 1600000000000, "maximum": 4102444800000 },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "byte": { "type": "integer", "minimum": 0, "maximum": 255 },
    "kelvin": { "type": "integer", "minimum": 1000, "maximum": 20000 },
    "transitionMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
    "lightType": { "enum": ["switch", "dimmer", "rgb", "rgbw", "cct"] },
    "lightOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["power"],
      "properties": {
        "power": { "type": "boolean" },
        "brightness": { "$ref": "#/$defs/percent" },
        "red": { "$ref": "#/$defs/byte" },
        "green": { "$ref": "#/$defs/byte" },
        "blue": { "$ref": "#/$defs/byte" },
        "white": { "$ref": "#/$defs/byte" },
        "colorTemperature": { "$ref": "#/$defs/kelvin" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "mac"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 48 },
        "board": { "type": "string", "maxLength": 48 },
        "mac": { "type": "string", "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$" },
        "chip": { "type": "string", "maxLength": 32 }
      }
    },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$", "maxLength": 32 }
  }
}
