{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lumen.invalid/protocol/v1/config-reported.schema.json",
  "title": "Reported configuration \u2014 topic lumen/v1/d/{device}/config/reported, retained (PROTOCOL.md \u00a75)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "device",
    "rev",
    "ts",
    "fw",
    "board",
    "caps",
    "lights",
    "rooms",
    "groups",
    "scenes",
    "automations"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "device": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "rev": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/timestampMs"
    },
    "fw": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "board": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "controllerId": {
      "type": "string",
      "maxLength": 32
    },
    "ip": {
      "type": "string",
      "format": "ipv4"
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ota": {
          "type": "boolean"
        },
        "backup": {
          "type": "boolean"
        }
      }
    },
    "lights": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "supports"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "type": {
            "$ref": "common.schema.json#/$defs/lightType"
          },
          "roomId": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "supports": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "brightness",
              "color",
              "white",
              "colorTemperature",
              "effects"
            ],
            "properties": {
              "brightness": {
                "type": "boolean"
              },
              "color": {
                "type": "boolean"
              },
              "white": {
                "type": "boolean"
              },
              "colorTemperature": {
                "type": "boolean"
              },
              "kelvinMin": {
                "$ref": "common.schema.json#/$defs/kelvin"
              },
              "kelvinMax": {
                "$ref": "common.schema.json#/$defs/kelvin"
              },
              "effects": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "maxLength": 24
                }
              }
            }
          }
        }
      }
    },
    "rooms": {
      "$ref": "#/$defs/namedList"
    },
    "groups": {
      "$ref": "#/$defs/namedList"
    },
    "scenes": {
      "$ref": "#/$defs/namedList"
    },
    "automations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "enabled"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "namedList": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/localId"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "members": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "common.schema.json#/$defs/localId"
            }
          }
        }
      }
    }
  }
}
