{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Board Profile",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "mcu",
    "resources",
    "peripherals"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "manufacturer": {
      "type": "string"
    },
    "mcu": {
      "type": "string",
      "enum": [
        "esp32",
        "esp32s3",
        "esp32c3",
        "esp32c6"
      ]
    },
    "description": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "peripherals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/peripheral"
      }
    },
    "capabilities": {
      "type": "object"
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "gpio",
            "pwm",
            "i2c",
            "uart",
            "rmt",
            "ethernet"
          ]
        },
        "gpio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        },
        "inverted": {
          "type": "boolean"
        },
        "pull": {
          "enum": [
            "none",
            "up",
            "down"
          ]
        },
        "safe_state": {
          "type": [
            "boolean",
            "integer",
            "null"
          ]
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": -1,
            "maximum": 48
          }
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "frequency": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "peripheral": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "pca9685",
            "pcf8574",
            "relay",
            "ethernet",
            "rs485",
            "addressable_led"
          ]
        },
        "bus": {
          "type": "string"
        },
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "frequency": {
          "type": "integer",
          "minimum": 1
        },
        "settings": {
          "type": "object"
        },
        "active_low": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
